# Copia este archivo como .env (local) o carga las mismas variables en
# Netlify → Site configuration → Environment variables. Luego vuelve a desplegar.

# Id del Form: el tramo 1FAIpQL... de https://docs.google.com/forms/d/e/<ID>/viewform
VITE_GOOGLE_FORM_ID=

# IDs de cada pregunta (formato entry.123456789), del "enlace prellenado".
# Obligatorias para enviar: CATEGORIA y CORREO. Las que dejes vacías no se envían.
VITE_GOOGLE_ENTRY_ID_CASO=
VITE_GOOGLE_ENTRY_CATEGORIA=
VITE_GOOGLE_ENTRY_CONFIANZA=
VITE_GOOGLE_ENTRY_CONSULTA=
VITE_GOOGLE_ENTRY_NOMBRE=
VITE_GOOGLE_ENTRY_CORREO=
VITE_GOOGLE_ENTRY_PEDIDO=
VITE_GOOGLE_ENTRY_PRENDA=
VITE_GOOGLE_ENTRY_MOTIVO_CAMBIO=
VITE_GOOGLE_ENTRY_TALLA_NUEVA=
VITE_GOOGLE_ENTRY_FECHA_PROMETIDA=
VITE_GOOGLE_ENTRY_DESCRIPCION_FALLA=
VITE_GOOGLE_ENTRY_PREFERENCIA_FALLA=
VITE_GOOGLE_ENTRY_RUC=
VITE_GOOGLE_ENTRY_RAZON_SOCIAL=
VITE_GOOGLE_ENTRY_DIRECCION_FISCAL=
VITE_GOOGLE_ENTRY_RESPUESTA_BOT=
